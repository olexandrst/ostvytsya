# Автозапуск квест-агента на Raspberry Pi (systemd).
# Встановлення:
#   sudo cp deploy/domovyk-quest.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now domovyk-quest
# Журнал:  journalctl -u domovyk-quest -f

[Unit]
Description=Ostvytsya voice quest agent (Domovychok)
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/ostvytsya
# Ключ API тримаємо у /home/pi/ostvytsya/.env (KEY=VALUE по рядку)
EnvironmentFile=/home/pi/ostvytsya/.env
ExecStart=/home/pi/ostvytsya/.venv/bin/python -m domovyk_quest --config config.yaml
Restart=always
RestartSec=5
# Перезапускати навіть після збоїв мережі/аудіо
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
