# Скопіюй у .env та підстав свої ключі:  cp .env.example .env

# ── Консольний режим (лялька на Raspberry Pi, Gemini Live) ───────────────────
# Ключ Gemini API: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here

# ── Веб-режим (браузер) ──────────────────────────────────────────────────────
# Кожен персонаж говорить або через OpenAI, або через Google — вибір у редакторі.
# Ключ OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-key-here
# Модель Realtime (типово gpt-realtime-2.1-mini; є більша gpt-realtime-2.1)
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
# Модель Gemini Live для веб-персонажів із моделлю Google (типово та сама, що в config.yaml)
# GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-09-2025

# Доступ до веб-панелі: ОДИН адміністратор, живе в базі панелі (SQLite).
# Ці змінні читаються лише при ПЕРШОМУ старті — щоб створити його. Далі
# пароль змінюється в самій панелі (/account) або
#   python -m web --set-admin-password "новий-пароль"
# і змінні на нього більше не впливають. Якщо пароль не задати — він буде
# згенерований і надрукований у лог (та в data/initial-admin-password.txt).
OSTVYTSYA_WEB_USER=admin
OSTVYTSYA_WEB_PASSWORD=change-me-please
# Замість пароля у відкритому вигляді можна покласти хеш (надійніше):
#   python -m web --hash-password "твій-пароль"
# OSTVYTSYA_WEB_PASSWORD_HASH=pbkdf2_sha256$240000$...

# Ключ підпису сесійної куки. Якщо не задано — генерується один раз і
# зберігається в базі панелі (сесії переживають перезапуск). Свій:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
OSTVYTSYA_WEB_SECRET=

# База панелі (SQLite): статуси терміналів, персонажі з телефонів, персонажі
# редактора, адміністратор. Типово data/ostvytsya.db у корені проєкту; на
# хостингу з постійним диском вкажи шлях на диску.
# OSTVYTSYA_DB_PATH=/var/data/ostvytsya.db
# Де зберігати персонажів редактора: sqlite (типово) | files | postgresql.
# Перекриває config.yaml → storage.backend.
# OSTVYTSYA_STORAGE_BACKEND=sqlite

# Де слухати (типово 127.0.0.1:8080)
OSTVYTSYA_WEB_HOST=127.0.0.1
OSTVYTSYA_WEB_PORT=8080

# Сховище персонажів у PostgreSQL — потрібне ЛИШЕ якщо задано
# storage.backend: postgresql (типово — sqlite, спільна база панелі).
# На Render підставляється автоматично, коли Managed PostgreSQL прив'язано
# до сервісу. Для локального тесту впиши свій рядок з'єднання:
# DATABASE_URL=postgresql://user:password@localhost:5432/ostvytsya
