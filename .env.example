# Скопіюй у .env та підстав свої ключі:  cp .env.example .env

# ── Консольний режим (лялька на Raspberry Pi, Gemini Live) ───────────────────
# Ключ Gemini API: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here

# ── Веб-режим (браузер) ──────────────────────────────────────────────────────
# Кожен персонаж говорить або через OpenAI, або через Google — вибір у редакторі.
# Ключ OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-key-here
# Модель Realtime (типово gpt-realtime-2.1-mini; є більша gpt-realtime-2.1)
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
# Модель Gemini Live для веб-персонажів із моделлю Google (типово та сама, що в config.yaml)
# GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-09-2025

# Доступ до веб-додатка
OSTVYTSYA_WEB_USER=admin
OSTVYTSYA_WEB_PASSWORD=change-me-please
# Замість пароля у відкритому вигляді можна покласти хеш (надійніше):
#   python -m web --hash-password "твій-пароль"
# OSTVYTSYA_WEB_PASSWORD_HASH=pbkdf2_sha256$240000$...

# Ключ підпису сесійної куки. Згенеруй свій:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Без нього сесії скидатимуться після кожного перезапуску сервера.
OSTVYTSYA_WEB_SECRET=

# Де слухати (типово 127.0.0.1:8080)
OSTVYTSYA_WEB_HOST=127.0.0.1
OSTVYTSYA_WEB_PORT=8080

# Сховище персонажів у PostgreSQL — потрібне ЛИШЕ якщо в config.yaml задано
# storage.render: yes (типово вимкнено, персонажі зберігаються як файли).
# На Render підставляється автоматично, коли Managed PostgreSQL прив'язано
# до сервісу. Для локального тесту впиши свій рядок з'єднання:
# DATABASE_URL=postgresql://user:password@localhost:5432/ostvytsya
